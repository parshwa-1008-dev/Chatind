{
  "name": "chatind",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @chatind/api\" \"npm run dev -w @chatind/web\"",
    "build": "npm run build -w @chatind/api && npm run build -w @chatind/web",
    "test": "npm run test -w @chatind/api && npm run test -w @chatind/web",
    "db:generate": "npm run db:generate -w @chatind/api",
    "db:migrate": "npm run db:migrate -w @chatind/api",
    "db:seed": "npm run db:seed -w @chatind/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
